# ──────────────────────────────────────────────
# PC_Connector – .gitignore
# ──────────────────────────────────────────────

# ── PC-Agent (Python / FastAPI) ──────────────
pc_agent/__pycache__/
pc_agent/**/__pycache__/
pc_agent/**/*.py[cod]
pc_agent/.venv/
pc_agent/venv/

# Runtime data – contains secrets & local state
pc_agent/paired_devices.json
pc_agent/chains.json
pc_agent/script_history.json
# Config contains MAC address and local network info
# Keep config.yaml.example but ignore the real one
pc_agent/config.yaml

# ── App (Vue / Nuxt / Capacitor / Electron) ──
web_app/node_modules/
web_app/.nuxt/
web_app/.output/
web_app/dist/
web_app/release/
# Generated native projects
web_app/android/
web_app/ios/

# ── IDE & OS ─────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & caches ────────────────────────────
*.log
pc_agent/.pytest_cache/
pc_agent/tests/__pycache__/

# ── PyInstaller build output ─────────────────
pc_agent/dist/
pc_agent/build/
pc_agent/__pycache__/
