# ──────────────────────────────────────────────
# PC_Connector – .gitignore
# ──────────────────────────────────────────────

# ── PC-Agent (Python / FastAPI) ──────────────
pc_agent/__pycache__/
pc_agent/**/__pycache__/
pc_agent/**/*.py[cod]
pc_agent/.venv/
pc_agent/venv/

# Runtime data – contains secrets & local state
pc_agent/paired_devices.json
pc_agent/chains.json
pc_agent/script_history.json
# Config contains MAC address and local network info
# Keep config.yaml.example but ignore the real one
pc_agent/config.yaml

# ── Flutter / Dart ───────────────────────────
mobile_app/.dart_tool/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.packages
mobile_app/.metadata
mobile_app/build/
mobile_app/android/.gradle/
mobile_app/android/app/debug/
mobile_app/android/app/profile/
mobile_app/android/app/release/
mobile_app/android/local.properties
mobile_app/android/key.properties
mobile_app/*.jks

# Unused Flutter platforms (Android-only project)
mobile_app/ios/
mobile_app/macos/
mobile_app/linux/
mobile_app/web/
mobile_app/windows/

# ── IDE & OS ─────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & caches ────────────────────────────
*.log
pc_agent/.pytest_cache/
pc_agent/tests/__pycache__/

# ── PyInstaller build output ─────────────────
pc_agent/dist/
pc_agent/build/
pc_agent/__pycache__/
